# 商品点餐系统 · 后端环境变量示例
# 用法：复制为 .env 并按真实值填写；CVM 上建议用 export 注入或用 pm2 env 管理，避免明文入库。

# ── 数据库（MySQL 8）──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=order_system

# ── 服务 ──
PORT=3000
PAY_MOCK=true              # true=演示模式（生成可渲染占位二维码，无需商户号）；false=接真实支付
PAY_QR_TTL_SEC=600         # 支付二维码有效秒数，超时未支付订单将被扫描器置为 cancelled

# ── 微信支付（仅当 PAY_MOCK=false 时填写）──
WECHAT_PAY_ENABLED=false
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=https://your-domain.com/api/pay/wechat/notify

# ── 支付宝（仅当 PAY_MOCK=false 时填写）──
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/pay/alipay/notify

# ── 前端基址（顾客端 APP / 收银端切真实后端时填 CVM 地址）──
# VITE/Flutter 侧：apiBaseUrl = https://your-domain.com  (走 Nginx 反代 /api)
